# ── Frontend / Auth Proxy (Path A) ─────────────────────────────────
NEXT_PUBLIC_ORGANIZATION_ID=
NEXT_PUBLIC_AUTH_PROXY_ID=
# NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID=   # alias for AUTH_PROXY_ID
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_BASE_URL=https://api.turnkey.com
NEXT_PUBLIC_AUTH_PROXY_URL=https://authproxy.turnkey.com
NEXT_PUBLIC_RH_RPC=https://rpc.mainnet.chain.robinhood.com

# ── Server / CLI stamped API (Path B) — REQUIRED for backend CLI ───
# Dashboard → API Keys → Create API key (parent org, root quorum able to approve)
# Public key starts with 02 or 03. NEVER commit private key. NEVER put in NEXT_PUBLIC_*.
BASE_URL=https://api.turnkey.com
API_PUBLIC_KEY=
API_PRIVATE_KEY=
