<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/titleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/subtitleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_php_to_usd"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bg"
        app:tabIndicatorColor="@color/accent"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/text_muted"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <ViewFlipper
        android:id="@+id/tabFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- CONVERT TAB -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Amount label + currency switch adjacent -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/inputLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/amount_label_php"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/swapButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="72dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/swap_to_usd"
                            android:textAllCaps="false"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:contentDescription="@string/swap_content_description"
                            app:strokeColor="@color/accent"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/amountEntry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/amount_hint_php"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:importantForAutofill="no" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/convertButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/convert_to_usd"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:backgroundTint="@color/button"
                        app:cornerRadius="8dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_result"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/resultLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/default_result_usd"
                            android:textColor="@color/success"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/rateInfoLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/fetching_rate"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- TRAVEL TAB -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/travelCurrencyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/travel_currency_php"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <!-- Distance label + unit switch adjacent -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/distanceUnitLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/distance_km"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/unitSwitchButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="72dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/switch_to_miles"
                            android:textAllCaps="false"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            app:strokeColor="@color/accent"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/distanceEntry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/distance_hint"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:id="@+id/distanceEquivLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingStart="4dp"
                        android:text=""
                        android:textColor="#6B7280"
                        android:textSize="11sp" />

                    <!-- Trip cost label + currency switch adjacent -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/travelCostLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/trip_cost_php"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/travelCurrencyButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="72dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/travel_price_usd"
                            android:textAllCaps="false"
                            android:textColor="@color/success"
                            android:textSize="12sp"
                            app:strokeColor="@color/success"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/travelCostEntry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/trip_cost_hint_php"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:id="@+id/travelCostFxLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingStart="4dp"
                        android:text=""
                        android:textColor="#6B7280"
                        android:textSize="11sp" />

                    <!-- Result early so it stays visible without scrolling past buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_result"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:minHeight="96dp">

                        <TextView
                            android:id="@+id/travelResultLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/travel_result_placeholder_km"
                            android:textColor="@color/success"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/travelResultFxLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/travelCalcButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/calc_per_km"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:backgroundTint="@color/button"
                        app:cornerRadius="8dp" />

                    <TextView
                        android:id="@+id/travelStatusLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/travel_enter_both"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/travelRateLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/fetching_rate"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- SETTINGS TAB -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_display"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_result_size_help"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/resultSizeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/sizeSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/size_small"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent" />

                        <RadioButton
                            android:id="@+id/sizeMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/size_medium"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent" />

                        <RadioButton
                            android:id="@+id/sizeLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/size_large"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/sizeXLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/size_xlarge"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/settingsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text=""
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>
    </ViewFlipper>

    <TextView
        android:id="@+id/versionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="v1.3.0"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
